# Copy to .env.local and adjust. All values are public (they ship in the client bundle).
# Values are read at BUILD time: after changing any of them, rebuild and redeploy.

# ── RPC ──────────────────────────────────────────────────────────────────────
# Mainnet RPC. Empty = https://api.mainnet-beta.solana.com, which is heavily rate limited:
# use your own provider (Helius, Triton, QuickNode, …) in production. It must allow CORS from your
# domain. A websocket endpoint is NOT needed: mopi confirms transactions by HTTP polling.
VITE_SOLANA_RPC_URL=
# Devnet RPC. Empty = https://api.devnet.solana.com.
VITE_SOLANA_DEVNET_RPC_URL=

# Fallback endpoints (comma-separated, https only). When the endpoint above fails with a network
# error, a 15 s timeout or HTTP 401 / 402 / 403 / 404 / 408 / 410 / 429 / 5xx, the exact same request
# is retried against these in order, and the one that answered is preferred for the next minute.
# Set to "none" to disable. Use endpoints of the SAME cluster only.
# Mainnet default (empty): https://solana-rpc.publicnode.com (free, public, CORS enabled), but only
# while VITE_SOLANA_RPC_URL is empty. With your own provider there is no fallback unless you list one
# here, so wallet addresses and signed transactions never go to a third party you didn't choose.
# Devnet default: none.
VITE_SOLANA_RPC_FALLBACKS=
VITE_SOLANA_DEVNET_RPC_FALLBACKS=

# Priority fee: real cleanups use the 75th percentile of getRecentPrioritizationFees, clamped to
# 20,000 … 1,000,000 micro-lamports per compute unit (src/config.ts priorityFeeMicroLamports /
# maxPriorityFeeMicroLamports). Not an env var; the safety check refuses any price above 1,000,000.

# ── Fees ─────────────────────────────────────────────────────────────────────
# Wallet that receives the service fee. Leave empty to charge no service fee.
# It MUST already exist with at least 0.00089088 SOL (the rent-exempt minimum of a system account):
# Solana rejects a transfer that leaves a brand-new account below that minimum. mopi reads its
# balance when a review opens and blocks approval ("fee wallet unfunded") until it is funded.
VITE_FEE_WALLET=

# Service fee in basis points of the account SOL being returned (400 = 4%, capped at 1000).
VITE_SERVICE_FEE_BPS=400
# Reduced fee for $MOPI holders (200 = 2%).
VITE_HOLDER_FEE_BPS=200

# ── $MOPI ────────────────────────────────────────────────────────────────────
# $MOPI mint (contract address). Leave empty until the token exists: holder perks then show as
# "planned" and no CA is displayed. Once set (and redeployed), the CA shows in the footer, the home
# holder banner and the Benefits page with copy + Solscan buttons.
VITE_MOPI_MINT=
# Minimum $MOPI balance (whole tokens) that counts as holder access.
VITE_MOPI_HOLDER_MIN=100000

# ── Community links ──────────────────────────────────────────────────────────
# Official X and Telegram links (https:// only; anything else is ignored with a console warning).
# Empty hides the link everywhere (header, mobile menu, footer).
VITE_X_URL=
VITE_TELEGRAM_URL=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin of this deployment (no trailing slash), e.g. https://mopi.example.
# Used at build time for the canonical link and the absolute og:image share preview.
VITE_SITE_URL=
