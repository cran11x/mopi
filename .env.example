# Copy to .env.local and adjust. All values are public (they ship in the client bundle).

# RPC endpoints. The public endpoints are heavily rate limited — use your own provider in production.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Wallet that receives the service fee. Leave empty to charge no service fee.
VITE_FEE_WALLET=

# Service fee in basis points of the account SOL being returned (400 = 4%).
VITE_SERVICE_FEE_BPS=400
# Reduced fee for $MOPI holders (200 = 2%).
VITE_HOLDER_FEE_BPS=200

# $MOPI mint. Leave empty until the token exists — holder perks then show as "planned".
VITE_MOPI_MINT=
# Minimum $MOPI balance (whole tokens) that counts as holder access.
VITE_MOPI_HOLDER_MIN=100000
